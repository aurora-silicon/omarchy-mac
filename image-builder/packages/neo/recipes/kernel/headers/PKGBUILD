# Maintainer: Ryan Murray <ryan@aurorasilicon.org>
# Pinned public headers plus native ARM HOSTCC helpers; runtime reused unchanged.
pkgname=linux-aurora-headers
pkgver=7.1.12.aurora20261014.r2.gd32c6c2
pkgrel=1
pkgdesc='Public Aurora Neo kernel headers with native AArch64 build helpers'
arch=('aarch64')
url='https://github.com/aurora-silicon/linux'
license=('GPL-2.0-only')
depends=('clang' 'llvm' 'lld' 'pahole')
provides=("linux-asahi-headers=$pkgver")
conflicts=('linux-asahi-headers')
options=('!strip' '!debug')
source=('headers-stage.tar' 'native-helper-receipt.json' 'COPYING' 'LICENSES.tar')
sha256sums=('84bf6c230c5f83c192e4b2f65bd1144f4580c6b15793bd625b9883663c1562c6' '0ad7b3fe85cac695cfadcac48655bc6c3c5e2edbc45c57827d2413c8f7521a2c' 'fb5a425bd3b3cd6071a3a9aff9909a859e7c1158d54d32e07658398cd67eb6a0' '4db3aa91b2d55c55297f54830fc926258ee0d00203c9654782409b9d68ebbd19')
check() {
  python3 - "$srcdir" <<'PY'
from pathlib import Path
import hashlib,json,struct,sys
root=Path(sys.argv[1]);r=json.loads((root/'native-helper-receipt.json').read_text())
assert r['status']=='PASS'
assert hashlib.file_digest((root/'stage/.config').open('rb'),'sha256').hexdigest()==r['config_sha256']
for item in r['helpers']:
    p=root/'stage'/item['path'];b=p.read_bytes()
    assert hashlib.sha256(b).hexdigest()==item['sha256']
    assert struct.unpack_from('<H',b,18)[0]==183
PY
}
package() {
  local release=7.1.12-aurora-j700-beta-r69-20261014
  local destination="$pkgdir/usr/lib/modules/$release/build"
  install -d "$destination"
  cp -a stage/. "$destination/"
  install -d "$pkgdir/usr/src"
  ln -s "../lib/modules/$release/build" "$pkgdir/usr/src/linux-aurora"
  install -Dm644 native-helper-receipt.json "$pkgdir/usr/share/doc/$pkgname/native-helper-receipt.json"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  cp -a LICENSES "$pkgdir/usr/share/licenses/$pkgname/"
}

# Maintainer: Ryan Murray <ryan@aurorasilicon.org>
# Incremental build of public 5f6c917 from the preserved d32 cache.
# Rebuilt PMGR and SEP, relinked Image and updated the J700 DTB.
pkgname=linux-aurora
pkgver=7.1.12.aurora20261014.r3.g5f6c917
pkgrel=1
pkgdesc='Public Aurora Neo kernel, modules and complete Apple DTB roster (candidate)'
arch=('aarch64')
url='https://github.com/aurora-silicon/linux'
license=('GPL-2.0-only')
depends=('coreutils' 'kmod' 'initramfs' 'm1n1>=1.6.1')
provides=("linux-asahi=$pkgver" 'WIREGUARD-MODULE')
conflicts=('linux-asahi')
options=('!strip' '!debug')
source=('kernel-runtime.tar' 'reuse-receipt.json' 'config')
sha256sums=('b7c594cfdc8465f33d86caee53c2edea2e69536a99c5b05c42802309201dd306' 'd4f70caee5f054132e48381a5722dffa1950b7feadfa13c9e9e10c8195a93d3a' 'fb8a0c1e96bef82638829628ec4809c32856ba08214c7718b8aee2e9cbb9a971')
check() {
  python3 - "$srcdir" <<'VERIFY'
from pathlib import Path
import hashlib,json,sys
r=Path(sys.argv[1]);m=json.loads((r/'reuse-receipt.json').read_text())
pin='5f6c917f2c824b3c87497e8bd7dd92a6de0efe60'
if m.get('build_mode') == 'clean-source':
 assert m.get('actual_compile_source') == pin and m.get('requested_public_pin') == pin
 release=m['release']
 assert release.endswith('-aurora-g5f6c917') and '/' not in release and '\\' not in release
 assert m['config_sha256']==hashlib.file_digest((r/'config').open('rb'),'sha256').hexdigest()
 assert (r/'usr/lib/modules'/release/'vmlinuz').is_file()
else:
 assert 'actual_compile_source' not in m
 assert m.get('actual_incremental_source') == pin

for name,digest in m['files'].items():
 assert hashlib.file_digest((r/name).open('rb'),'sha256').hexdigest()==digest,name
VERIFY
}
package() {
  cp -a usr "$pkgdir/"
  install -Dm644 reuse-receipt.json "$pkgdir/usr/share/doc/$pkgname/reuse-receipt.json"
  install -Dm644 config "$pkgdir/usr/share/doc/$pkgname/build.config"
}

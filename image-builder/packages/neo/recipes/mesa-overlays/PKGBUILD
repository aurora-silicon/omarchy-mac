highmem=1

pkgbase=mesa
pkgname=(mesa-fex-emu-overlay-x86_64 mesa-fex-emu-overlay-i386 mesa-dummy)
pkgdesc="Mesa builds for the x86 FEX-Emu overlays"
pkgver=26.3.0.devel.20261014.g524105a
pkgrel=3
_pkgver=${pkgver/.devel/-devel}
# This release adds policy metadata; the compiled public524 version is unchanged.
_overlay_build_version="$_pkgver-arch2"
# x86 only: the native aarch64 mesa package now comes from [extra] (ALARM).
# This PKGBUILD only produces the FEX-Emu overlays (x86_64 + i386) and the
# mesa-dummy package used inside the x86_64 FEX rootfs, so it must be built
# on an x86_64 host.
arch=('x86_64')
# The overlays are erofs images consumed by FEX-Emu; nothing on the host links
# against them, so the split packages carry no runtime depends.

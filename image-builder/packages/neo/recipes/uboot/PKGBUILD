# Source: public aurora-silicon/u-boot, no downstream implementation patches.
# Maintainer: Ryan Murray <ryan@aurorasilicon.org>
pkgname=uboot-asahi
pkgver=2026.10.14.aurora0cb6fed6
pkgrel=2
pkgdesc='Public Aurora U-Boot candidate for Apple Silicon (hardware qualification pending)'
arch=('aarch64')
url='https://github.com/aurora-silicon/u-boot'
license=('GPL-2.0-or-later')
makedepends=('git' 'bc' 'dtc' 'openssl' 'python' 'swig')
options=('!strip' '!debug')
source=('uboot::git+https://github.com/aurora-silicon/u-boot.git#commit=0cb6fed6a10512d1013a4a80b6d83c3d56140f2f')
sha256sums=(SKIP)
prepare() {
  [[ $(git -C uboot rev-parse HEAD) == 0cb6fed6a10512d1013a4a80b6d83c3d56140f2f ]]
  [[ -z $(git -C uboot status --porcelain --untracked-files=all --ignored=matching) ]]
}
build() {
  cd uboot
  local cross=${AURORA_CROSS_COMPILE:-}
  make O=build CROSS_COMPILE="$cross" apple_m1_defconfig
  make O=build CROSS_COMPILE="$cross" -j"${OMARCHY_BUILD_JOBS:-10}"
}
package() {
  cd uboot
  install -Dm644 build/u-boot-nodtb.bin "$pkgdir/usr/lib/asahi-boot/u-boot-nodtb.bin"
  install -Dm644 build/.config "$pkgdir/usr/share/doc/$pkgname/build.config"
  local dtb model count=0
  for dtb in build/dts/upstream/src/arm64/apple/*.dtb; do
    model=$(fdtget "$dtb" / model)
    case "$model" in
      'Apple Mac'*|'Apple iMac'*)
        install -Dm644 "$dtb" "$pkgdir/usr/lib/asahi-boot/dtb/${dtb##*/}"
        count=$((count + 1))
        ;;
    esac
  done
  ((count > 0)) || { printf '%s\n' 'No compiled Apple Silicon Mac device trees' >&2; return 1; }
  install -Dm644 Licenses/README "$pkgdir/usr/share/licenses/$pkgname/README"
  cp -a Licenses "$pkgdir/usr/share/licenses/$pkgname/upstream"
  printf '%s\n' '0cb6fed6a10512d1013a4a80b6d83c3d56140f2f' > "$pkgdir/usr/share/doc/$pkgname/source-revision"
}
